identity_name                     = "rapticore-access-prod-uami"
location                          = "eastus"
resource_group_name               = ""
role_scope                        = "/subscriptions/00000000-0000-0000-0000-000000000000"

federated_credential_name         = "rapticore-oidc"
federated_credential_subject      = ""
federated_credential_audience     = "api://AzureADTokenExchange"
federated_credential_issuer       = ""

# ----------------------------------------------------------------------------------
# OPTIONAL: onboard this SAME Azure tenant to additional Rapticore tenants.
# Each Rapticore tenant has its own Cognito identity pool, so it has its own
# `subject` (Rapticore gives you the value). They all federate to the ONE managed
# identity above — no extra Azure resources, no second scanner to pay for. Azure
# allows up to 20 federated credentials per identity. `audience`/`issuer` may be
# omitted; they default to the primary credential's values.
# ----------------------------------------------------------------------------------
# additional_federated_credentials = [
#   {
#     name    = "rapticore-oidc-staging"
#     subject = ""   # provided by Rapticore for that tenant
#   },
# ]

assign_builtin_roles = [
  {
    role_name = "Reader"
    scope     = "/subscriptions/00000000-0000-0000-0000-000000000000"
  }
]

custom_permissions = [
  "Microsoft.Storage/storageAccounts/read",
  "Microsoft.Storage/storageAccounts/write",
  "Microsoft.Storage/storageAccounts/blobServices/read",
  "Microsoft.Storage/storageAccounts/blobServices/write",
  "Microsoft.Storage/storageAccounts/listKeys/action",
  "Microsoft.Storage/storageAccounts/regenerateKey/action",
  "Microsoft.Network/networkSecurityGroups/read",
  "Microsoft.Network/networkSecurityGroups/write",
  "Microsoft.Web/sites/config/list/action",
  "Microsoft.Web/sites/write",
  "Microsoft.Web/sites/config/write",
  "Microsoft.Web/sites/config/read",
  "Microsoft.Web/sites/functions/listkeys/action",
  "Microsoft.Web/sites/functions/read",
  "Microsoft.Web/sites/syncfunctiontriggers/action"
]

aws_sqs_queue_url   = "https://sqs.us-west-2.amazonaws.com/123456789012/my-queue"
aws_oidc_audience   = "api://{AZURE_TENANT_ID}"
aws_role_arn        = "arn:aws:iam::123456789012:role/my-aws-role"
aws_region          = "us-west-2"

# ----------------------------------------------------------------------------------
# OPTIONAL: a SECOND RTTM forwarder in this same Azure tenant.
# Only needed when this Azure tenant must forward real-time threat events to more
# than one Rapticore tenant AT THE SAME TIME. The Function App and Event Hub
# namespace names are globally unique and the Entra diagnostic setting is unique
# per Azure tenant, so the second deployment collides without a suffix. Also give
# it its own resource_group_name and its own Terraform state key.
#
# Cheaper alternative: if you only need to MOVE RTTM to a different Rapticore
# tenant, just change aws_sqs_queue_url / aws_role_arn above instead — a second
# forwarder duplicates the Event Hub, Function App, storage and Log Analytics,
# and streams the same Entra logs twice.
# ----------------------------------------------------------------------------------
# rttm_deployment_suffix = "staging"

# ----------------------------------------------------------------------------------
# OPTIONAL: Entra ID Protection risk logs (RiskyUsers, UserRiskEvents)
# Requires an Entra ID P2 license. Leave false (or omit) on non-P2 tenants.
# ----------------------------------------------------------------------------------
# enable_entra_id_protection_logs = false

# ----------------------------------------------------------------------------------
# OPTIONAL: narrow the Entra log categories RTTM exports.
# Default (omit) = the seven categories below, as before. Sign-in categories need
# Entra ID P1 or P2; AuditLogs does not, so ["AuditLogs"] works on any tenant.
# [] creates no Entra diagnostic setting at all.
# ----------------------------------------------------------------------------------
# entra_log_categories = [
#   "AuditLogs",
#   "SignInLogs",
#   "NonInteractiveUserSignInLogs",
#   "ServicePrincipalSignInLogs",
#   "ManagedIdentitySignInLogs",
#   "ADFSSignInLogs",
#   "MicrosoftServicePrincipalSignInLogs",
# ]

# ----------------------------------------------------------------------------------
# OPTIONAL: WAF logs and Defender for Cloud alerts  (ALL DEFAULT OFF)
# Each line is independent. All three need the second Rapticore queue
# (aws_cloud_event_sqs_queue_url, provided by Rapticore): without it the records
# reach your Event Hub -- and are billed there -- but are not forwarded.
# WAF logs are one event per request the firewall matched; see the README for cost.
# ----------------------------------------------------------------------------------
# aws_cloud_event_sqs_queue_url = "https://sqs.us-west-2.amazonaws.com/123456789012/my-cloud-event-queue"
# waf_application_gateway_ids = [
#   "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/my-rg/providers/Microsoft.Network/applicationGateways/my-gateway",
# ]
# waf_front_door_profile_ids = [
#   "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/my-rg/providers/Microsoft.Cdn/profiles/my-front-door",          # Standard/Premium
#   "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/my-rg/providers/Microsoft.Network/frontDoors/my-classic-fd",  # classic
# ]
# enable_defender_alert_export = false

# ----------------------------------------------------------------------------------
# OPTIONAL: Remediation WRITE identity  (DEFAULT OFF -- read-only unless enabled)
# Provisions a SEPARATE managed identity that Rapticore uses ONLY for automated
# remediation writes. Leave enable_remediation_write = false for read-only posture.
# When you set it true you MUST also set the three federated-credential values below;
# Rapticore supplies the issuer and subject (same as the scanner). Keep the audience
# identical to the scanner's federated_credential_audience.
# ----------------------------------------------------------------------------------
# enable_remediation_write                  = false
# remediation_role_scope                    = ""   # empty reuses role_scope (subscription); set an RG id to scope tighter
# remediation_federated_credential_name     = "rapticore-remediation-write-oidc"
# remediation_federated_credential_issuer   = ""   # provided by Rapticore
# remediation_federated_credential_subject  = ""   # provided by Rapticore -- MUST differ from the scanner subject
# remediation_federated_credential_audience = "api://AzureADTokenExchange"